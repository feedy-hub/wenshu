#!/bin/sh
set -eu
resources="$(CDPATH= cd -- "$(dirname -- "$0")/../Resources" && pwd)"
python="${WENSHU_PYTHON:-$(command -v python3 || true)}"
if [ -z "$python" ] || ! "$python" -c 'import sys, pymupdf; assert sys.version_info >= (3, 10)' >/dev/null 2>&1; then
  /usr/bin/osascript -e 'display alert "文枢缺少 Python 或 PyMuPDF" message "请先安装 Python 3.10+，并运行 python3 -m pip install PyMuPDF。"' >/dev/null 2>&1 || true
  exit 1
fi
export SHORE_READER_DATA="${SHORE_READER_DATA:-$HOME/Library/Application Support/文枢}"
exec "$python" "$resources/launch.py"
